{
  "manifest_version": 3,
  "name": "ITIN Enrollment Helper for Chase",
  "short_name": "ITIN Helper",
  "version": "1.0.0",
  "description": "Lets you enroll in Chase online banking with an ITIN instead of an SSN. No setup required.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://secure.chase.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
